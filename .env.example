# ── OpenAI / NVIDIA NIM ──────────────────────────────
# Use NVIDIA NIM API key for enhanced natural language responses
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── Database ────────────────────────────────────────
DATABASE_URL=sqlite:///./data/enterprise.db

# ── Debug ───────────────────────────────────────────
DEBUG=True

# ── Integrations: Email (Gmail SMTP) ────────────────
# Required for sending real emails. Use a Gmail "App Password".
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ── Integrations: Google Calendar ───────────────────
# Path to service-account JSON or authorized_user token
GOOGLE_CREDENTIALS_PATH=credentials/google_creds.json
GOOGLE_CALENDAR_ID=primary

# ── Integrations: Slack ─────────────────────────────
# Incoming Webhook URL for posting messages
SLACK_WEBHOOK_URL=

# ── Integrations: GitHub ────────────────────────────
# Personal Access Token with admin:org or repo scope
GITHUB_TOKEN=
GITHUB_ORG=
